# ============================================
# UNDANGANKU - Environment Configuration
# ============================================
# Copy file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke repository!

# ============================================
# DATABASE
# ============================================
# PostgreSQL (Supabase / Neon / Vercel Postgres)
# DATABASE_URL = koneksi pooled       -> dipakai runtime aplikasi (serverless)
# DIRECT_URL   = koneksi non-pooling  -> dipakai `prisma db push` / `prisma migrate`
#
# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL = Transaction pooler, port 6543. WAJIB pakai ?pgbouncer=true
#                  karena transaction pooler tidak mendukung prepared statements.
#                  connection_limit=1 disarankan untuk serverless.
#   DIRECT_URL   = Session pooler, port 5432. Jangan pakai mode "Direct connection"
#                  dari jaringan IPv4 -- Supabase membuatnya IPv6-only.
#
# Patokan paling aman: cocokkan berdasarkan PORT (6543 vs 5432).
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres"

# ============================================
# NEXTAUTH (NextAuth.js)
# ============================================
# URL aplikasi (ganti dengan domain production)
NEXTAUTH_URL="http://localhost:3000"
# Secret key untuk enkripsi JWT. Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# ============================================
# TRANSACTIONAL EMAIL (Resend)
# ============================================
# Wajib di production untuk verifikasi email dan reset password.
# Domain pada EMAIL_FROM harus sudah diverifikasi di dashboard Resend.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Undanganku <noreply@yourdomain.com>"

# ============================================
# GOOGLE OAUTH
# ============================================
# Dapatkan dari: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# MIDTRANS PAYMENT
# ============================================
# Dapatkan dari dashboard Midtrans (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
# Set ke "true" untuk production, "false" untuk sandbox
MIDTRANS_IS_PRODUCTION=false

# ============================================
# CLOUD STORAGE (Cloudinary)
# ============================================
# Daftar di https://cloudinary.com untuk mendapatkan credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"