generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // non-pooled connection (migrations)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("customer") // customer | admin
  status        String    @default("active") // active | suspended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  wedding    Wedding?
  orders     Order[]
  rsvps      RSVP[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  category  String
  image     String
  status    String   @default("active") // active | inactive
  features  String @default("[]")
  themeKey  String @default("classic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Wedding {
  id              String   @id @default(cuid())
  userId          String   @unique
  partner1        String
  partner2        String
  nickname1       String?
  nickname2       String?
  parent1         String?
  parent2         String?
  fatherPria      String?
  motherPria      String?
  fatherWanita    String?
  motherWanita    String?
  akadDate        DateTime?
  resepsiDate     DateTime?
  location        String?
  mapsUrl         String?
  message         String?
  quote           String?
  instagram1      String?
  instagram2      String?
  storyEnabled    Boolean @default(false)
  story           String  @default("[]")
  photos          String @default("[]")
  musicUrl        String?
  bankName        String?
  bankAccount     String?
  bankHolder      String?
  bankAccounts    String  @default("[]")
  qrisImage       String?
  customDomain    String?
  themeKey        String  @default("classic") // classic | modern
  slug            String  @unique // Short URL: /u/nama-mempelai-kode
  activeUntil     DateTime?
  status          String    @default("draft") // draft | active | expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests     Guest[]
  rsvps      RSVP[]
  messages   Message[]
  photoAlbum Photo[]
}

model Guest {
  id        String   @id @default(cuid())
  weddingId String
  name      String
  phone      String
  slug      String   @unique // Short URL slug for personalized invitation
  status    String   @default("pending") // pending | sent | confirmed
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvp    RSVP?

  @@index([weddingId])
  @@index([slug])
}


model RSVP {
  id               String   @id @default(cuid())
  weddingId        String
  userId           String
  guestId          String?  @unique // Satu tamu hanya boleh 1 RSVP
  name             String
  email            String?
  phone            String
  attendanceStatus String   @default("pending") // pending | confirmed | declined
  numberOfGuests   Int      @default(1)
  message          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([userId])
}


model Message {
  id          String   @id @default(cuid())
  weddingId   String
  guestName   String
  message     String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Photo {
  id          String   @id @default(cuid())
  weddingId   String
  url         String
  caption     String?
  category    String?  // prewedding | wedding | reception
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  templateId  String
  packageName String
  amount      Int
  method      String?  // qris | transfer | ewallet
  status      String   @default("pending") // pending | success | failed
  // Data Snap disimpan agar order pending bisa dilanjutkan (lihat nomor VA/QR lagi).
  snapToken       String?
  snapRedirectUrl String?
  snapExpiresAt   DateTime? // Snap token berlaku 24 jam sejak dibuat
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}